{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // No schedule, deliberately. Every image here is rebuilt and verified on the
  // PR and automerged only if that passes, so there is no value in batching
  // updates into a weekend window - it just means a Debian security update
  // found on a Monday waits six days. Renovate runs whenever it runs.

  // Automerge is the default here, not the exception. Every image in this repo
  // is rebuilt by build.yaml on the PR, and Renovate only automerges once all
  // status checks pass (ignoreTests stays false), so a bump that breaks a
  // build never reaches main. `main` has no protection rules, so this relies
  // on Renovate's own check gating rather than GitHub's - keep ignoreTests off.
  automerge: true,
  automergeType: "pr",
  // Squash so main keeps one commit per bump rather than a merge commit.
  automergeStrategy: "squash",

  // Nothing here is consumed by anything but this repo's own builds and the
  // home-ops pins, so let digest/pin updates through unattended too.
  minor: { automerge: true },
  patch: { automerge: true },
  pin: { automerge: true },
  digest: { automerge: true },
  lockFileMaintenance: { enabled: true, automerge: true },

  packageRules: [
    {
      // Pin every Docker reference to a digest. Without this, a floating tag
      // is invisible to Renovate: debian:trixie-slim keeps its name across
      // every Debian point release and security rebuild, and the CNPG operand
      // is repushed under the same 18.6-standard-trixie tag. Nothing here
      // would open a PR, and the drift would land unrecorded in the weekly
      // cron rebuild instead. With a digest pinned, a rebased tag is an
      // update: it opens a PR, the build verifies it, and it automerges.
      //
      // Note what this does NOT do: the published tag comes from the matrix
      // `version`, not from the base image, so a digest-only rebuild pushes
      // the SAME tag with new contents. ktmb1/home-ops pins every
      // ghcr.io/ktmb1/* image by digest as well as tag, so it sees such a
      // rebuild as a digest update - a consumer pinning by tag alone would
      // not, and would swap contents on its next pull without a diff.
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      // Actions are pinned by SHA with a version comment; majors here have
      // been runtime bumps, and the build proves them before merge.
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pin"],
      automerge: true,
    },
    {
      // The Postgres base image and the TimescaleDB source tag have to move
      // together - the extension is compiled against the operand's PG major.
      // Minor/patch build and merge on their own; a PG major has to land in
      // lockstep with the CNPG operand bump in home-ops, so that one waits.
      matchPackageNames: ["timescale/timescaledb", "postgres", "docker.io/library/postgres"],
      groupName: "TimescaleDB & PostgreSQL",
      automerge: true,
    },
    {
      matchPackageNames: ["timescale/timescaledb", "postgres", "docker.io/library/postgres"],
      matchUpdateTypes: ["major"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // The CNPG operand is referenced twice - the `operand:` matrix entry in
      // build.yaml and `ARG PG_OPERAND_IMAGE` in the extension Dockerfile -
      // and the two are now owned by different managers (a custom regex and
      // the built-in dockerfile one). They must not drift: the extension is
      // compiled against the ARG and then verified against the matrix entry,
      // so a bump landing in only one of them builds against one operand and
      // tests against another. Grouping keeps both edits in a single PR.
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      groupName: "CNPG operand",
    },
  ],

  // The TimescaleDB version and PG major are build args in the workflow matrix
  // rather than image tags, so Renovate needs telling where to look.
  customManagers: [
    {
      customType: "regex",
      description: "TimescaleDB release tag in the build matrix",
      managerFilePatterns: ["/^\\.github/workflows/build\\.yaml$/"],
      // Anchored on pg_major, which only the TimescaleDB entry has, but with
      // the intervening `versions:` line allowed: it was added later and
      // silently broke the original `version:`-then-`pg_major:` pairing, so
      // TimescaleDB releases stopped being tracked with no visible failure.
      matchStrings: ["version:\\s*\"(?<currentValue>.*?)\"(?:.|\\n)*?pg_major:"],
      depNameTemplate: "timescale/timescaledb",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^(?<version>.*)$",
    },
    {
      customType: "regex",
      description: "CNPG operand image the extension is built against and verified in",
      managerFilePatterns: ["/^\\.github/workflows/build\\.yaml$/"],
      // The digest is captured separately, not left to fall into currentValue.
      // pinDigests appends "@sha256:..." here, and a currentValue of
      // "18.6-standard-trixie@sha256:..." is not a tag Renovate can look up -
      // the operand would quietly stop being tracked, the same way the
      // TimescaleDB manager above once did.
      matchStrings: ["operand:\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: "chrony package version in the build matrix",
      managerFilePatterns: ["/^\\.github/workflows/build\\.yaml$/"],
      // Anchored on the chrony matrix entry's own `version:` so this cannot
      // match the TimescaleDB one above it, which the manager before this
      // already owns.
      matchStrings: ["name: chrony(?:.|\\n)*?version:\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "chrony",
      datasourceTemplate: "deb",
      // Must match the base image's suite: a version from a different suite
      // would not be installable by the Dockerfile's pinned apt-get.
      registryUrlTemplate: "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
      // Debian versions ("4.6.1-3+deb13u2") are not semver; the deb versioning
      // scheme knows how to order the revision and +deb13uN suffixes.
      versioningTemplate: "deb",
    },
    {
      customType: "regex",
      description: "chrony package version pinned in the chrony Dockerfile",
      managerFilePatterns: ["/^chrony/Dockerfile$/"],
      matchStrings: ["ARG CHRONY_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "chrony",
      datasourceTemplate: "deb",
      registryUrlTemplate: "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
      versioningTemplate: "deb",
    },
    {
      customType: "regex",
      description: "Predbat release tag in the build matrix",
      managerFilePatterns: ["/^\\.github/workflows/build\\.yaml$/"],
      // Anchored on the predbat matrix entry's own `version:` so it cannot
      // match the TimescaleDB or chrony entries above it.
      matchStrings: ["name: predbat(?:.|\\n)*?version:\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "springfall2008/batpred",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Predbat release tag pinned in the predbat Dockerfile",
      managerFilePatterns: ["/^predbat/Dockerfile$/"],
      matchStrings: ["ARG PREDBAT_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "springfall2008/batpred",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Python dependencies pinned in the predbat Dockerfile",
      managerFilePatterns: ["/^predbat/Dockerfile$/"],
      // Predbat's own requirements.txt is almost entirely unpinned, so the
      // versions are pinned in the Dockerfile instead and tracked here.
      matchStrings: ["\"(?<depName>[a-zA-Z0-9_.-]+)==(?<currentValue>[^\"]+)\""],
      datasourceTemplate: "pypi",
    },
    // Deliberately NO custom manager for timescaledb-extension/Dockerfile's
    // `ARG PG_OPERAND_IMAGE=...`. The built-in dockerfile manager already
    // extracts that line: `FROM ${PG_OPERAND_IMAGE}` makes Renovate resolve
    // the ARG default, so the dep is found without help here.
    //
    // A custom manager on the same line is not merely redundant, it breaks
    // updates. Both managers emit an edit to that one line, both land in the
    // same branch, and the second one's expected content no longer matches
    // the file the first already rewrote - the branch write aborts with
    // "Error updating branch: update failure". That took out the whole
    // pin-dependencies branch, debian:trixie-slim included, for every run
    // between adding pinDigests and removing this manager.
  ],
}
